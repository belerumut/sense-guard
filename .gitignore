# monorepo root gitignore

# Node.js
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment files (secret keys, passwords)
**/.env
**/.env.local
**/.env.*.local
**/.env.*
*.env

# Build outputs
**/dist/
**/web-build/
**/.expo/

# Temporary / Scratch Files
scratch/

# Log files
*.log
logs/

# IDE / Editor files
.vscode/
.idea/
.DS_Store
Thumbs.db
